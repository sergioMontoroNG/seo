HOST=0.0.0.0
PORT=3000
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATA_DIR=/data
# JSON map: {"ES":{"name":"España","domain":"shop.myshopify.com","token_env":"SHOPIFY_ES_TOKEN"}}
STORES_JSON={}
SHOPIFY_API_VERSION=2026-07
# Optional simple internal Basic Auth; leave both empty to rely on LAN firewall.
AUTH_USER=
AUTH_PASSWORD=
# Turn off to disable FAQ writes while diagnosing a target store.
FAQ_WRITES_ENABLED=true
# Comma separated corporate CIDRs for firewall documentation; network firewall remains authoritative.
INTERNAL_CIDRS=
